<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Self-extractor stub. Published as a small, trimmed, self-contained single-file console program;
    LzFilm (the GUI) embeds it and writes it in front of the archive when "self-extracting" is chosen.
    Publish:  dotnet publish src\LzFilm.Sfx -c Release -r win-x64 -o artifacts\sfx
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>LzFilm.Sfx</AssemblyName>
    <RootNamespace>LzFilm.Sfx</RootNamespace>
    <Version>0.5.0</Version>
    <InvariantGlobalization>true</InvariantGlobalization>
    <ApplicationIcon>..\LzFilm.App\lzfilm.ico</ApplicationIcon>
  </PropertyGroup>

  <PropertyGroup Condition="'$(RuntimeIdentifier)' != ''">
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <PublishTrimmed>true</PublishTrimmed>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <IncludeAllContentForSelfExtract>true</IncludeAllContentForSelfExtract>
    <DebuggerSupport>false</DebuggerSupport>
    <EventSourceSupport>false</EventSourceSupport>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\LzFilm.Core\LzFilm.Core.csproj" />
  </ItemGroup>

  <ItemGroup Condition="Exists('..\..\native\liblzma.dll')">
    <None Include="..\..\native\liblzma.dll" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
